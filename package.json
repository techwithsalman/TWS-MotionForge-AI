{
  "name": "tws-motionforge-ai",
  "version": "1.0.0",
  "description": "TWS MotionForge AI — 100% Free Local AI Video Production Studio",
  "main": "src/electron/main.mjs",
  "type": "module",
  "author": "Tech With Salman",
  "publisherName": "Tech With Salman",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test-ui": "electron . --dry-run",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.techwithsalman.motionforgeai",
    "productName": "TWS MotionForge AI",
    "copyright": "Copyright © 2026 Tech With Salman",
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "skills/directing-stickman-videos",
        "to": "skills/directing-stickman-videos",
        "filter": [
          "assets/**/*",
          "scripts/**/*",
          "node_modules/**/*",
          "references/**/*",
          "SKILL.md",
          "package.json"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/license.txt",
        "to": "build/license.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "TWS-MotionForge-AI-Setup-${version}.${ext}",
      "legalTrademarks": "Tech With Salman"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "license": "build/license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TWS MotionForge AI",
      "uninstallDisplayName": "TWS MotionForge AI",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "runAfterFinish": true
    },
    "asar": false
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  }
}
